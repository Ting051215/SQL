@model CourseCompass.Models.User

@{
    ViewBag.Title = "註冊帳號";
}

<div class="container" style="margin-top: 60px; max-width: 500px;">
    <div class="panel panel-default shadow" style="border-radius: 12px; border: none; box-shadow: 0 8px 24px rgba(0,0,0,0.12);">

        <div class="panel-heading text-center" style="background-color: #e3f2fd; color: #0d47a1; border-top-left-radius: 12px; border-top-right-radius: 12px; padding: 25px 20px; border-bottom: 2px solid #bbdefb;">
            <h3 class="panel-title" style="font-weight: bold; font-size: 22px; margin: 0; letter-spacing: 1px;">
                📝 註冊新帳號
            </h3>
            <p style="margin: 5px 0 0 0; font-size: 14px; color: #495057; opacity: 0.8;">加入選課指南針，規劃你的完美課表</p>
        </div>

        <div class="panel-body" style="padding: 35px 40px;">

            @if (!string.IsNullOrEmpty(ViewBag.msg))
            {
                <div class="alert alert-danger" style="border-radius: 8px; padding: 12px 15px; margin-bottom: 25px; font-weight: bold; display: flex; align-items: center; font-size: 14px;">
                    <i class="glyphicon glyphicon-exclamation-sign" style="margin-right: 8px; font-size: 16px;"></i>
                    @ViewBag.msg
                </div>
            }

            @using (Html.BeginForm("Register", "User", FormMethod.Post, new { style = "margin: 0;" }))
            {
                @Html.AntiForgeryToken()

                <div class="form-group" style="margin-bottom: 20px;">
                    <label style="font-weight: 600; color: #495057; font-size: 15px; margin-bottom: 8px;">學號</label>
                    @Html.TextBoxFor(m => m.studentID, new { @class = "form-control", placeholder = "請輸入學號", required = "required", style = "border-radius: 8px; height: 45px; font-size: 15px; box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);" })
                </div>

                <div class="form-group" style="margin-bottom: 20px;">
                    <label style="font-weight: 600; color: #495057; font-size: 15px; margin-bottom: 8px;">年級</label>
                    @Html.TextBoxFor(m => m.grade, new { @class = "form-control", placeholder = "例如：大一、大二...", required = "required", style = "border-radius: 8px; height: 45px; font-size: 15px; box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);" })
                </div>

                <div class="form-group" style="margin-bottom: 20px;">
                    <label style="font-weight: 600; color: #495057; font-size: 15px; margin-bottom: 8px;">系所</label>
                    @Html.TextBoxFor(m => m.department, new { @class = "form-control", placeholder = "請輸入您的系所名稱", required = "required", style = "border-radius: 8px; height: 45px; font-size: 15px; box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);" })
                </div>

                <div class="form-group" style="margin-bottom: 20px;">
                    <label style="font-weight: 600; color: #495057; font-size: 15px; margin-bottom: 8px;">自訂帳號</label>
                    @Html.TextBoxFor(m => m.account, new { @class = "form-control", placeholder = "請設定登入帳號", required = "required", style = "border-radius: 8px; height: 45px; font-size: 15px; box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);" })
                </div>

                <div class="form-group" style="margin-bottom: 30px;">
                    <label style="font-weight: 600; color: #495057; font-size: 15px; margin-bottom: 8px;">設定密碼</label>
                    @Html.PasswordFor(m => m.password, new { @class = "form-control", placeholder = "請設定密碼", required = "required", style = "border-radius: 8px; height: 45px; font-size: 15px; box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);" })
                </div>

                <button type="submit" class="btn btn-primary btn-block" style="border-radius: 8px; height: 48px; font-weight: bold; font-size: 16px; letter-spacing: 3px; margin-bottom: 20px; box-shadow: 0 4px 6px rgba(0, 123, 255, 0.2);">
                    立即註冊
                </button>
            }

            <hr style="border-top: 1px dashed #e9ecef; margin: 25px 0 20px 0;" />

            <div class="text-center">
                <span style="color: #6c757d; font-size: 14px;">已經有帳號了嗎？</span>
                <a href="@Url.Action("Login", "User")" style="font-weight: bold; color: #007bff; text-decoration: none; margin-left: 5px; font-size: 14px; transition: color 0.2s;">
                    返回登入
                </a>
            </div>

        </div>
    </div>
</div>
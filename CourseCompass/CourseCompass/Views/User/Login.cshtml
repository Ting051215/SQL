@{
    ViewBag.Title = "學生登入";
}

<div class="container" style="margin-top: 80px; max-width: 450px;">
    <div class="panel panel-default shadow" style="border-radius: 12px; border: none; box-shadow: 0 8px 24px rgba(0,0,0,0.12);">

        <div class="panel-heading text-center" style="background-color: #e3f2fd; color: #0d47a1; border-top-left-radius: 12px; border-top-right-radius: 12px; padding: 25px 20px; border-bottom: 2px solid #bbdefb;">
            <h3 class="panel-title" style="font-weight: bold; font-size: 22px; margin: 0; letter-spacing: 1px;">
                🧭 選課指南針
            </h3>
            <p style="margin: 5px 0 0 0; font-size: 14px; color: #495057; opacity: 0.8;">請登入您的學生帳號</p>
        </div>

        <div class="panel-body" style="padding: 35px 40px;">

            @if (!string.IsNullOrEmpty(ViewBag.msg))
            {
                <div class="alert alert-danger" style="border-radius: 8px; padding: 12px 15px; margin-bottom: 25px; font-weight: bold; display: flex; align-items: center; font-size: 14px;">
                    <i class="glyphicon glyphicon-exclamation-sign" style="margin-right: 8px; font-size: 16px;"></i>
                    @ViewBag.msg
                </div>
            }

            <form method="post">
                <div class="form-group" style="margin-bottom: 20px;">
                    <label style="font-weight: 600; color: #495057; font-size: 15px; margin-bottom: 8px;">帳號</label>
                    <input type="text" name="account" class="form-control" placeholder="請輸入您的學號" required style="border-radius: 8px; height: 45px; font-size: 15px; box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);" />
                </div>

                <div class="form-group" style="margin-bottom: 30px;">
                    <label style="font-weight: 600; color: #495057; font-size: 15px; margin-bottom: 8px;">密碼</label>
                    <input type="password" name="password" class="form-control" placeholder="請輸入密碼" required style="border-radius: 8px; height: 45px; font-size: 15px; box-shadow: inset 0 1px 2px rgba(0,0,0,0.05);" />
                </div>

                <button type="submit" class="btn btn-primary btn-block" style="border-radius: 8px; height: 48px; font-weight: bold; font-size: 16px; letter-spacing: 3px; margin-bottom: 20px; box-shadow: 0 4px 6px rgba(0, 123, 255, 0.2);">
                    登入
                </button>
            </form>

            <hr style="border-top: 1px dashed #e9ecef; margin: 25px 0 20px 0;" />

            <div class="text-center">
                <span style="color: #6c757d; font-size: 14px;">還沒有帳號？</span>
                <a href="@Url.Action("Register", "User")" style="font-weight: bold; color: #007bff; text-decoration: none; margin-left: 5px; font-size: 14px; transition: color 0.2s;">
                    立即註冊帳號
                </a>
            </div>

        </div>
    </div>
</div>
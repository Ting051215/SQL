<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - 選課指南針</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <style>
        .body-content {
            margin-top: 25px;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark shadow-sm">
        <div class="container">
            <span class="navbar-brand fw-bold text-white mb-0" style="cursor: default;">🧭 選課指南針</span>

            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="切換導覽" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Course")">📚 課程總覽</a>
                    </li>

                    @* 只有登入後才能看到「我的收藏」 *@
                    @if (Session["studentID"] != null)
                    {
                        <li class="nav-item">
                            <a class="nav-link" href="@Url.Action("Index", "Collect")">⭐ 我的收藏</a>
                        </li>
                    }
                </ul>

                <ul class="navbar-nav">
                    @if (Session["studentID"] != null)
                    {
                        <li class="nav-item">
                            <span class="nav-link text-info" style="cursor: default;">
                                👤 @Session["studentID"]
                            </span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-danger" style="font-weight: bold;" href="@Url.Action("Logout", "User")">登出</a>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-success" style="font-weight: bold;" href="@Url.Action("Login", "User")">🔑 學生登入</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <div class="container body-content">
        @RenderBody()

        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - 選課指南針系統</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
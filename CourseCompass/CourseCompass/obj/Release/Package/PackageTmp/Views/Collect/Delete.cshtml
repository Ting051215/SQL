@model CourseCompass.Models.Collect

@{
    ViewBag.Title = "移除收藏";
}

<div class="container mt-5">
    <div class="alert alert-warning shadow-sm">
        <h3 class="text-danger"><i class="glyphicon glyphicon-warning-sign"></i> 確定要移除這門課程的收藏嗎？</h3>
        <hr />

        <dl class="dl-horizontal" style="font-size: 16px;">
            <dt>課程代碼：</dt>
            <dd>@Model.courseID</dd>

            <dt>收藏時間：</dt>
            <dd>@Model.collectTime.ToString("yyyy-MM-dd HH:mm")</dd>

            @if (!string.IsNullOrEmpty(Model.note))
            {
                <dt>我的筆記：</dt>
                <dd>@Model.note</dd>
            }
        </dl>

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-actions no-color mt-4">
                <input type="submit" value="確定刪除" class="btn btn-danger" />
                <span class="mx-2"> | </span>
                @Html.ActionLink("取消並返回清單", "Index", null, new { @class = "btn btn-default" })
            </div>
        }
    </div>
</div>